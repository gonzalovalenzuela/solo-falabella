{
  "manifest_version": 3,
  "name": "Filtro de vendedor para Falabella.com",
  "version": "1.0.3",
  "description": "Filtra los listados de falabella.com (Chile) por vendedor: Falabella, Sodimac o Tottus.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://www.falabella.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Filtro de vendedor para Falabella.com",
    "default_popup": "popup.html"
  }
}
