{
  "manifest_version": 3,
  "name": "Solo Falabella",
  "version": "1.0.1",
  "description": "Filtra los listados de falabella.com (Chile) para mostrar solo productos vendidos por Falabella.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://www.falabella.com/*"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Solo Falabella",
    "default_popup": "popup.html"
  }
}
