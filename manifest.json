{
  "manifest_version": 2,
  "name": "Solo Falabella",
  "version": "1.0.2",
  "description": "Filtra los listados de falabella.com (Chile) por vendedor: Falabella, Sodimac o Tottus.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "tabs",
    "storage",
    "*://www.falabella.com/*"
  ],
  "background": {
    "scripts": ["common.js", "background.js"],
    "persistent": false
  },
  "browser_action": {
    "default_icon": "icon.svg",
    "default_title": "Solo Falabella",
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "solo-falabella@gonzalovalenzuela.cl",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
